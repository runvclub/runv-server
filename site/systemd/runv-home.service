# Regenera data/members.json e a home (pt/en) do runv.club a partir do estado real
# do servidor. Disparado por runv-home.timer (de hora em hora).
#
# Instalação (root):
#   install -m 644 site/systemd/runv-home.service site/systemd/runv-home.timer /etc/systemd/system/
#   # ajuste RUNV_REPO abaixo se o checkout não estiver em /opt/runv-server
#   systemctl daemon-reload
#   systemctl enable --now runv-home.timer
#   systemctl start runv-home.service && journalctl -u runv-home.service -n 20
#
# Corre como root porque build_directory.py lê /var/lib/runv/users.json (privado).
# A escrita fica limitada ao DocumentRoot; as homes são só leitura.

[Unit]
Description=runv.club: regenerar members.json e a home
After=local-fs.target

[Service]
Type=oneshot
Environment=RUNV_REPO=/opt/runv-server
Environment=RUNV_DOCROOT=/var/www/runv.club/html
ExecStart=/usr/bin/python3 ${RUNV_REPO}/site/build_directory.py --users-json /var/lib/runv/users.json --homes-root /home -o ${RUNV_DOCROOT}/data/members.json
ExecStart=/usr/bin/python3 ${RUNV_REPO}/site/build_home.py --out-dir ${RUNV_DOCROOT} --members-json ${RUNV_DOCROOT}/data/members.json --homes-root /home --diary ${RUNV_REPO}/site/diario.txt --manifesto-dir ${RUNV_REPO}/site
ExecStartPost=/bin/chown -R www-data:www-data ${RUNV_DOCROOT}/index.html ${RUNV_DOCROOT}/en/index.html ${RUNV_DOCROOT}/data/members.json
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/runv.club/html
ProtectHome=read-only
PrivateTmp=true
PrivateNetwork=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
